---
import HomeLayout from "../layouts/HomeLayout.astro";
import Button from "../components/CtaLink.astro";

import videoPoster from "../images/portfolio-sequence-poster.png";
import videoMp4 from "../images/portfolio-sequence.h264.mp4";
import videoWebm from "../images/portfolio-sequence.av1.webm";

const pageTitle = "Home";
---

<script>
  import { gsap } from "gsap";
  import { initGlobalLenis } from "../lib/initGlobalLenis";
  import { initFlowers } from "../lib/initFlowers";

  type CleanupFn = () => void;

  declare global {
    interface Window {
      __mwHomeIntroCleanup?: CleanupFn;
      __mwHomeIntroListenersBound?: boolean;
    }
  }

  const siteTypes = [
    "ecommerce sites",
    "web applications",
    "dashboards & portals",
    "marketing sites",
    "SaaS platforms",
  ];

  const toLetterSpans = (el, text) => {
    el.textContent = "";
    const fragment = document.createDocumentFragment();

    text.split("").forEach((char) => {
      const letterEl = document.createElement("span");
      letterEl.className = "site-type-letter";
      letterEl.style.display = "inline-block";
      letterEl.textContent = char === " " ? "\u00A0" : char;
      fragment.appendChild(letterEl);
    });

    el.appendChild(fragment);
    return Array.from(el.querySelectorAll(".site-type-letter"));
  };

  const animateSiteType = () => {
    const siteTypeEl = document.querySelector("#siteType");
    const siteTypeStopEl = document.querySelector("#siteTypeStop");
    const siteTypeLineEl = document.querySelector("#siteTypeLine");
    const gsapRef = gsap;
    const animations = new Set<gsap.core.Animation>();
    const track = (animation: gsap.core.Animation) => {
      for (const previous of animations) {
        if (previous.progress() === 1) animations.delete(previous);
      }
      animations.add(animation);
    };

    if (!siteTypeEl) {
      return;
    }

    let currentIndex = 0;
    let isAnimating = false;

    toLetterSpans(siteTypeEl, siteTypeEl.textContent.trim());

    const runCycle = () => {
      if (isAnimating) {
        return;
      }

      isAnimating = true;

      const currentLetters = Array.from(
        siteTypeEl.querySelectorAll(".site-type-letter")
      );

      track(
        gsapRef.to(currentLetters, {
          opacity: 0,
          duration: 0.28,
          ease: "power3.in",
          stagger: 0.03,
          onComplete: () => {
            siteTypeEl.textContent = "";

            if (siteTypeStopEl) {
              track(
                gsapRef.fromTo(
                  siteTypeStopEl,
                  { opacity: 0.5, color: "#ff2d8d" },
                  {
                    opacity: 1,
                    color: "#111111",
                    duration: 1.5,
                    ease: "power2.out",
                  }
                )
              );
            }

            const nextText = siteTypes[currentIndex];
            currentIndex = (currentIndex + 1) % siteTypes.length;
            const nextLetters = toLetterSpans(siteTypeEl, nextText);
            const letterStagger = 0.03;
            const letterPopDuration = 0.12;
            const letterSettleDuration = 0.2;
            const letterDelay = 0.12;

            if (siteTypeLineEl) {
              const textBounds = siteTypeEl.getBoundingClientRect();
              track(
                gsapRef
                  .timeline({ delay: letterDelay })
                  .set(siteTypeLineEl, {
                    scaleX: 0,
                    opacity: 0,
                    transformOrigin: "left center",
                  })
                  .to(
                    siteTypeLineEl,
                    {
                      opacity: 1,
                      duration: 0.25,
                      ease: "power3.out",
                    },
                    0
                  )
                  .to(
                    siteTypeLineEl,
                    {
                      keyframes: nextLetters.map((letter, index) => ({
                        scaleX:
                          (letter.getBoundingClientRect().right -
                            textBounds.left) /
                          textBounds.width,
                        duration:
                          index === 0 ? letterPopDuration : letterStagger,
                        ease: "none",
                      })),
                    },
                    0
                  )
                  .set(siteTypeLineEl, { transformOrigin: "right center" })
                  .to(siteTypeLineEl, {
                    scaleX: 0,
                    duration: letterSettleDuration,
                    ease: "power2.out",
                  })
              );
            }

            gsapRef.set(nextLetters, {
              opacity: 0.2,
              color: "#ff2d8d",
              scale: 1,
              transformOrigin: "50% 70%",
            });
            track(
              gsapRef.to(nextLetters, {
                keyframes: [
                  {
                    opacity: 1,
                    color: "#111111",
                    scale: 1.12,
                    duration: letterPopDuration,
                    ease: "power4.out",
                  },
                  {
                    scale: 1,
                    duration: letterSettleDuration,
                    ease: "power3.out",
                  },
                ],
                stagger: letterStagger,
                delay: letterDelay,
                onComplete: () => {
                  isAnimating = false;
                  track(gsapRef.delayedCall(1, runCycle));
                },
              })
            );
          },
        })
      );
    };

    track(gsapRef.delayedCall(1, runCycle));
    return () => animations.forEach((animation) => animation.kill());
  };

  const cleanupHomeIntro = () => {
    window.__mwHomeIntroCleanup?.();
    window.__mwHomeIntroCleanup = undefined;
  };

  const initHomeIntro = () => {
    cleanupHomeIntro();
    if (!document.querySelector(".work-section")) return;

    initGlobalLenis();
    const video = document.querySelector<HTMLVideoElement>(".work-image");
    const cleanupVideoFlowers = video ? initFlowers(video) : undefined;
    const title = document.querySelector<HTMLElement>(".bloom-title");
    const cleanupTitleFlowers = title ? initFlowers(title, "underline") : undefined;
    const cleanupType = !window.matchMedia("(prefers-reduced-motion: reduce)").matches
      ? animateSiteType()
      : undefined;
    window.__mwHomeIntroCleanup = () => {
      cleanupVideoFlowers?.();
      cleanupTitleFlowers?.();
      cleanupType?.();
    };
  };

  if (!window.__mwHomeIntroListenersBound) {
    document.addEventListener("astro:before-swap", cleanupHomeIntro);
    document.addEventListener("astro:page-load", initHomeIntro);
    window.__mwHomeIntroListenersBound = true;
  }

  initHomeIntro();
</script>

<HomeLayout pageTitle={pageTitle}>
  <section class="work-section">
    <h2 class="bloom-title">
      <span>Big</span>{" "}<span>ideas.</span>{" "}<span>Beautifully</span>{" "}<span>built.</span>
    </h2>
    <div class="work-sequence-container">
      <div class="col-1">
        <p class="work-intro">
          From the first pixel to the final deployment, making <span
            class="site-type-wrap"
            ><span id="siteType" class="whitespace-nowrap">sites</span><span
              id="siteTypeLine"
              aria-hidden="true"></span></span
          >that stand out..
        </p>
        <div class="cta">
          <Button href="/work/swiftaid" text="View Projects" />
          <p>Bright ideas to beautifully built digital experiences.</p>
        </div>
      </div>
      <div class="col-2">
        <video
          autoplay
          muted
          playsinline
          loop
          width="615"
          height="430"
          class="work-image"
          poster={videoPoster.src}
        >
          <source type="video/mp4" src={videoMp4} />
          <source type="video/webm" src={videoWebm} />
          <p>Download and watch <a href={videoMp4}>video</a></p>
        </video>
      </div>
    </div>
  </section>
</HomeLayout>

<style>
  .bloom-title span {
    display: inline-block;
    padding-bottom: 0.2em;
    margin-bottom: -0.2em;
    color: var(--color-emphasis);
    background: linear-gradient(
      110deg,
      var(--color-emphasis) 10%,
      #b51c65 35%,
      #b58900 55%,
      var(--color-emphasis) 80%
    );
    background-size: 250% 100%;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    transform-origin: 50% 80%;
    animation: title-bloom 0.9s cubic-bezier(0.16, 1, 0.3, 1) both,
      title-colour 8s ease-in-out infinite alternate;
  }

  .bloom-title span:nth-child(2) { animation-delay: 0.08s, -1s; }
  .bloom-title span:nth-child(3) { animation-delay: 0.16s, -2s; }
  .bloom-title span:nth-child(4) { animation-delay: 0.24s, -3s; }

  @keyframes title-bloom {
    from { opacity: 0; transform: translateY(0.18em) scale(0.94) rotate(-1deg); }
    to { opacity: 1; transform: translateY(0) scale(1) rotate(0); }
  }

  @keyframes title-colour {
    from { background-position: 0% 50%; }
    to { background-position: 100% 50%; }
  }

  @media (prefers-reduced-motion: reduce) {
    .bloom-title span { animation: none; }
  }

  @media (forced-colors: active) {
    .bloom-title span {
      background: none;
      -webkit-text-fill-color: currentColor;
    }
  }

  .site-type-wrap {
    position: relative;
    display: inline-block;
  }

  #siteTypeLine {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.08em;
    height: 5px;
    background: var(--color-emphasis);
    opacity: 0;
    transform: scaleX(0);
    transform-origin: left center;
    pointer-events: none;
  }
</style>
