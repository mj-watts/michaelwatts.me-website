---
import ElasticLine from "../components/ElasticLine.astro";
import ProgressiveBlur from "../components/ProgressiveBlur.astro";
import WorkLayout from "../layouts/WorkLayout.astro";
import ArrowRight from "../components/icons/ArrowRight.astro";
import Mouse from "../components/icons/Mouse.astro";

const { frontmatter } = Astro.props;
const { title, description, summary, nextTitle, nextDescription, nextLink } =
  frontmatter;
---

<WorkLayout
  pageTitle={title}
  pageDescription={description}
  nextTitle={nextTitle}
  nextDescription={nextDescription}
  nextLink={nextLink}
>
  <div class="row">
    <div class="col-1">
      <h1 class="heading">{title}</h1>
      {summary.map((para) => <p class="body">{para}</p>)}
    </div>

    <div class="col-2">
      <ul>
        {
          frontmatter.tags.map((tag: { tag: string }) => (
            <li>
              <span class="tag-jar" aria-hidden="true">
                <span class="tag-jar__fill">
                  <span class="tag-jar__liquid">
                    <svg class="tag-jar__wave" viewBox="0 0 44 6" preserveAspectRatio="none">
                      <path d="M0 2 Q5.5 0 11 2 T22 2 T33 2 T44 2 V6 H0 Z" fill="currentColor" />
                    </svg>
                  </span>
                </span>
                <span class="tag-jar__bubbles">
                  <span></span><span></span><span></span><span></span>
                </span>
                <ArrowRight />
                <span class="tag-jar__lid"></span>
              </span>
              <span class="tag-item tag-item--base">
                {tag}
              </span>
              <span class="tag-item tag-item--reveal" aria-hidden="true">
                {tag}
              </span>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="col-3">
      {['top-left', 'top-right', 'bottom-right', 'bottom-left'].map((corner) => (
        <svg class={`elastic-corner elastic-corner--${corner}`} viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M0.5 24 A23.5 23.5 0 0 1 24 0.5" stroke="currentColor" stroke-width="1" />
        </svg>
      ))}
      <ElasticLine edge="top" />
      <ElasticLine edge="bottom" />
      <ElasticLine edge="left" />
      <ElasticLine edge="right" />
      <div class="col-3-scroll">
        <slot />
      </div>
      <ProgressiveBlur />
      <div class="scroll-cta">
        <div class="text">Scroll for more...</div>
        <div><Mouse /></div>
      </div>
    </div>
  </div>
</WorkLayout>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { initGlobalLenis } from "../lib/initGlobalLenis";

  gsap.registerPlugin(ScrollTrigger);
  type CleanupFn = () => void;

  declare global {
    interface Window {
      __mwWorkLayoutNewCleanup?: CleanupFn;
      __mwWorkLayoutNewListenersBound?: boolean;
    }
  }

  const cleanupCurrentPage = () => {
    window.__mwWorkLayoutNewCleanup?.();
    window.__mwWorkLayoutNewCleanup = undefined;
  };

  const setupCurrentPage = () => {
    cleanupCurrentPage();
    initGlobalLenis();

    const col3 = document.querySelector(".col-3");
    const scroller = document.querySelector(".col-3-scroll");
    const scrollCta = document.querySelector(".scroll-cta");

    if (
      !(col3 instanceof HTMLElement) ||
      !(scroller instanceof HTMLElement) ||
      !(scrollCta instanceof HTMLElement)
    ) {
      return;
    }

    const cleanups: CleanupFn[] = [];
    const addCleanup = (cleanup: CleanupFn) => cleanups.push(cleanup);

    const updateScrollCta = () => {
      col3.classList.toggle("is-scrolled", scroller.scrollTop > 8);
      const atBottom = scroller.scrollHeight - scroller.clientHeight - scroller.scrollTop <= 2;
      col3.style.setProperty("--work-blur-opacity", atBottom ? "0" : "1");
    };
    updateScrollCta();
    scroller.addEventListener("scroll", updateScrollCta, { passive: true });
    addCleanup(() => scroller.removeEventListener("scroll", updateScrollCta));
    scroller.addEventListener("load", updateScrollCta, true);
    addCleanup(() => scroller.removeEventListener("load", updateScrollCta, true));
    const blurResizeObserver = new ResizeObserver(updateScrollCta);
    blurResizeObserver.observe(scroller);
    if (scroller.firstElementChild) blurResizeObserver.observe(scroller.firstElementChild);
    addCleanup(() => blurResizeObserver.disconnect());

    const reduceMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)"
    ).matches;

    if (!reduceMotion) {
      const content = document.querySelector(".col-3-scroll > .content");
      const work = document.querySelector(".row");
      const col1 = document.querySelector(".col-1");
      const col2 = document.querySelector(".col-2");
      const listItems = gsap.utils.toArray<HTMLElement>(".col-2 li");

      if (content && work && col1 && col2) {
        const pinTrigger = ScrollTrigger.create({
          scroller,
          trigger: content,
          start: "top top",
          endTrigger: content,
          end: "bottom bottom-=100",
        });
        addCleanup(() => pinTrigger.kill());
      }

      // Route page-level scroll intent into the internal .col-3 scroller.
      const isEditableElement = (
        target: EventTarget | null
      ): target is HTMLElement => {
        if (!(target instanceof HTMLElement)) return false;
        return Boolean(
          target.closest(
            'input, textarea, select, [contenteditable="true"], [contenteditable=""]'
          )
        );
      };

      const scrollCol3By = (deltaY: number) => {
        if (!deltaY || !scroller.isConnected) return;
        scroller.scrollBy({ top: deltaY, behavior: "auto" });
      };

      const isDesktopLayout = () =>
        window.matchMedia("(min-width: 1024px)").matches;

      const onWindowWheel = (event: WheelEvent) => {
        if (!isDesktopLayout()) return;
        if (isEditableElement(event.target)) return;
        event.preventDefault();
        scrollCol3By(event.deltaY);
      };

      let touchStartY = 0;
      const onTouchStart = (event: TouchEvent) => {
        if (isEditableElement(event.target)) return;
        if (event.touches.length > 0) {
          touchStartY = event.touches[0].clientY;
        }
      };

      const onTouchMove = (event: TouchEvent) => {
        if (!isDesktopLayout()) return;
        if (isEditableElement(event.target)) return;
        if (event.touches.length === 0) return;
        const currentY = event.touches[0].clientY;
        const deltaY = touchStartY - currentY;
        touchStartY = currentY;
        event.preventDefault();
        scrollCol3By(deltaY);
      };

      const onKeyDown = (event: KeyboardEvent) => {
        if (!isDesktopLayout()) return;
        if (isEditableElement(event.target)) return;

        let deltaY = 0;
        const pageAmount = scroller.clientHeight * 0.9;
        switch (event.key) {
          case "ArrowDown":
            deltaY = 60;
            break;
          case "ArrowUp":
            deltaY = -60;
            break;
          case "PageDown":
            deltaY = pageAmount;
            break;
          case "PageUp":
            deltaY = -pageAmount;
            break;
          case "Home":
            deltaY = -scroller.scrollTop;
            break;
          case "End":
            deltaY =
              scroller.scrollHeight -
              scroller.clientHeight -
              scroller.scrollTop;
            break;
          case " ":
            deltaY = event.shiftKey ? -pageAmount : pageAmount;
            break;
          default:
            return;
        }

        event.preventDefault();
        scrollCol3By(deltaY);
      };

      window.addEventListener("wheel", onWindowWheel, { passive: false });
      window.addEventListener("touchstart", onTouchStart, { passive: true });
      window.addEventListener("touchmove", onTouchMove, { passive: false });
      window.addEventListener("keydown", onKeyDown);
      addCleanup(() => {
        window.removeEventListener("wheel", onWindowWheel);
        window.removeEventListener("touchstart", onTouchStart);
        window.removeEventListener("touchmove", onTouchMove);
        window.removeEventListener("keydown", onKeyDown);
      });

      if (content && listItems.length > 0) {
        gsap.set(listItems, { "--reveal-progress": 0 });
        listItems.forEach((item) => {
          item.dataset.revealState = "hidden";
        });

        const popAnimations = new Map<HTMLElement, gsap.core.Timeline>();
        const popItem = (item: HTMLElement) => {
          const particles = Array.from({ length: gsap.utils.random(10, 15, 1) }, () => {
            const particle = document.createElement("span");
            particle.className = "tag-pop-particle";
            particle.style.backgroundColor = Math.random() < 0.5 ? "var(--color-white)" : "var(--color-emphasis)";
            particle.setAttribute("aria-hidden", "true");
            const size = gsap.utils.random(2, 4);
            particle.style.width = `${size}px`;
            particle.style.height = `${size * gsap.utils.random(0.6, 1.4)}px`;
            particle.style.borderRadius = Math.random() < 0.5 ? "50%" : "1px";
            item.appendChild(particle);
            const angle = gsap.utils.random(-Math.PI, 0);
            const speed = gsap.utils.random(40, 95);
            return {
              particle,
              vx: Math.cos(angle) * speed,
              vy: Math.sin(angle) * speed - gsap.utils.random(8, 20),
              drag: gsap.utils.random(1.8, 2.8),
              gravity: gsap.utils.random(140, 220),
              spin: gsap.utils.random(-420, 420),
              lifetime: gsap.utils.random(0.6, 0.9),
              shimmerPhase: gsap.utils.random(0, Math.PI * 2),
              shimmerRate: gsap.utils.random(18, 30),
            };
          });
          const pop = gsap.timeline({ onComplete: () => {
            particles.forEach(({ particle }) => particle.remove());
            popAnimations.delete(item);
          }});
          popAnimations.set(item, pop);
          const lid = item.querySelector(".tag-jar__lid");
          if (lid) {
            pop.fromTo(lid, { x: 0, y: 0, rotation: 0, opacity: 1 }, {
              x: gsap.utils.random(-10, 10), y: -28,
              rotation: gsap.utils.random(-40, 40), opacity: 0,
              duration: 0.45, ease: "power2.out",
            }, 0);
          }
          particles.forEach(({ particle, vx, vy, drag, gravity, spin, lifetime, shimmerPhase, shimmerRate }) => {
            const flight = { time: 0 };
            const setTransform = gsap.quickSetter(particle, "css");
            // Solve velocity drag and gravity from elapsed time, independent of frame rate.
            pop.to(flight, {
              time: lifetime, duration: lifetime, ease: "none",
              onUpdate: () => {
                const t = flight.time;
                const travel = (1 - Math.exp(-drag * t)) / drag;
                const progress = t / lifetime;
                const glimmer = (Math.sin(t * shimmerRate + shimmerPhase) + 1) / 2;
                setTransform({
                  x: vx * travel,
                  y: vy * travel + (gravity / drag) * (t - travel),
                  rotation: spin * t,
                  opacity: Math.min(1, (1 - progress) / 0.35) * (0.7 + 0.3 * glimmer),
                  filter: `brightness(${1 + glimmer * 1.5}) drop-shadow(0 0 ${glimmer * 3}px var(--color-emphasis))`,
                  scale: 1 - progress * 0.45,
                });
              },
            }, 0);
          });
        };
        addCleanup(() => {
          popAnimations.forEach((animation) => animation.kill());
          popAnimations.clear();
          listItems.forEach((item) => {
            item.querySelectorAll(".tag-pop-particle").forEach((particle) => particle.remove());
            gsap.set(item, { clearProps: "transform" });
          });
        });

        const revealTween = gsap.to(listItems, {
          "--reveal-progress": 1,
          ease: "none",
          stagger: {
            each: 0.5,
          },
          scrollTrigger: {
            scroller,
            trigger: content,
            endTrigger: content,
            start: "top top",
            end: "bottom bottom",
            scrub: 2.5,
          },
          onUpdate() {
            listItems.forEach((item) => {
              const revealProgress = Number(
                getComputedStyle(item).getPropertyValue("--reveal-progress")
              );
              item.style.setProperty("--bubble-play-state", revealProgress > 0 && revealProgress < 0.98 ? "running" : "paused");

              if (revealProgress < 0.98) {
                if (item.dataset.revealState === "revealed") {
                  popAnimations.get(item)?.kill();
                  popAnimations.delete(item);
                  item.querySelectorAll(".tag-pop-particle").forEach((particle) => particle.remove());
                  item.querySelector(".tag-icon--animate")?.classList.remove("tag-icon--animate");
                  gsap.set(item, { clearProps: "transform,transformOrigin" });
                  const lid = item.querySelector(".tag-jar__lid");
                  if (lid) gsap.set(lid, { clearProps: "all" });
                }
                item.dataset.revealState = "hidden";
                return;
              }

              if (
                revealProgress < 0.98 ||
                item.dataset.revealState === "revealed"
              ) {
                return;
              }

              const revealIcon = item.querySelector<HTMLElement>(
                ".tag-jar .icon-container"
              );
              if (!revealIcon) return;

              revealIcon.classList.remove("tag-icon--animate");
              void revealIcon.offsetWidth;
              revealIcon.classList.add("tag-icon--animate");
              popItem(item);
              item.dataset.revealState = "revealed";
            });
          },
        });

        addCleanup(() => {
          revealTween.scrollTrigger?.kill();
          revealTween.kill();
        });

        listItems.forEach((item) => {
          const revealIcon = item.querySelector<HTMLElement>(
            ".tag-jar .icon-container"
          );
          if (!revealIcon) return;

          const onAnimationEnd = () => {
            revealIcon.classList.remove("tag-icon--animate");
          };

          revealIcon.addEventListener("animationend", onAnimationEnd);
          addCleanup(() => {
            revealIcon.removeEventListener("animationend", onAnimationEnd);
          });
        });
      }

      requestAnimationFrame(() => ScrollTrigger.refresh());
    }

    window.__mwWorkLayoutNewCleanup = () => {
      cleanups.forEach((cleanup) => cleanup());
    };
  };

  if (!window.__mwWorkLayoutNewListenersBound) {
    document.addEventListener("astro:before-swap", cleanupCurrentPage);
    document.addEventListener("astro:page-load", setupCurrentPage);
    window.__mwWorkLayoutNewListenersBound = true;
  }

  setupCurrentPage();
</script>
