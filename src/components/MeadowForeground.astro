<div
  class="meadow-foreground"
  data-meadow
  aria-hidden="true"
></div>

<script>
  let cleanup: (() => void) | undefined;
  let pending: IntersectionObserver | undefined;
  let generation = 0;

  const dispose = () => {
    generation++;
    pending?.disconnect();
    pending = undefined;
    cleanup?.();
    cleanup = undefined;
  };

  const setup = () => {
    dispose();
    const host = document.querySelector<HTMLElement>("[data-meadow]");
    if (!host) return;
    const current = generation;
    pending = new IntersectionObserver(async ([entry]) => {
      if (!entry.isIntersecting || current !== generation) return;
      pending?.disconnect();
      try {
        const { createMeadow } = await import("../lib/meadow");
        if (current !== generation || !host.isConnected) return;
        const disposeMeadow = await createMeadow(host);
        if (current !== generation || !host.isConnected) disposeMeadow();
        else cleanup = disposeMeadow;
      } catch (error) {
        // The existing landscape remains visible when WebGL is unavailable.
        console.warn("The meadow foreground could not be loaded.", error);
      }
    }, { rootMargin: "200px" });
    pending.observe(host);
  };

  document.addEventListener("astro:before-swap", dispose);
  document.addEventListener("astro:page-load", setup);
  setup();
</script>

<style>
  .meadow-foreground {
    position: absolute;
    left: 50%;
    width: max(100%, 1000px);
    transform: translateX(-50%);
    bottom: 0;
    height: 100%;
    z-index: 40;
    overflow: hidden;
    pointer-events: none;
    mask-image: linear-gradient(to bottom, transparent, black 8%, black 94%, transparent);
  }

  .meadow-foreground :global(canvas) {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>
