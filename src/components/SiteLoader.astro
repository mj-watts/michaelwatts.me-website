<div class="loading-container" aria-hidden="true" transition:persist="site-loader">
  <div class="loading-screen">
    <div class="loading__progress"><div class="loading__progress-inner"></div></div>
    <div class="loading__numbers">
      <div class="loading__number-group is--first">
        <div class="loading__number-wrap"><span class="loading__number">1</span></div>
      </div>
      <div class="loading__number-group is--second">
        <div class="loading__number-wrap">{[1,2,3,4,5,6,7,8,9,0].map(number => <span class="loading__number">{number}</span>)}</div>
      </div>
      <div class="loading__number-group is--third">
        <div class="loading__number-wrap">{[1,2,3,4,5,6,7,8,9,0].map(number => <span class="loading__number">{number}</span>)}</div>
      </div>
      <div class="loading__percentage-wrap"><span class="loading__percentage">%</span></div>
    </div>
  </div>
</div>

<script>
  import { gsap } from "gsap";

  function initLoaderThreeSteps() {
    const container = document.querySelector<HTMLElement>(".loading-container");
    if (!container || container.dataset.initialized) return;
    container.dataset.initialized = "true";
    const select = gsap.utils.selector(container);
    // Keep the supplied timing local to the loader's timeline.
    const tl = gsap.timeline({
      defaults: { ease: "Expo.easeInOut", duration: 1.2 },
      onComplete: () => { container.hidden = true; },
    });
    const randomNumbers1 = gsap.utils.random([2, 3, 4]);
    const randomNumbers2 = gsap.utils.random([5, 6]);
    const randomNumbers3 = gsap.utils.random([1, 5]);
    const randomNumbers4 = gsap.utils.random([7, 8, 9]);

    tl.set(select(".loading-screen"), { display: "block" });
    tl.set(select(".loading__progress-inner"), { scaleY: 0 });
    tl.set(select(".loading__number-group.is--first .loading__number-wrap, .loading__percentage"), { yPercent: 100 });
    tl.set(select(".loading__number-group.is--second .loading__number-wrap, .loading__number-group.is--third .loading__number-wrap"), { yPercent: 10 });
    tl.to(select(".loading__progress-inner"), { scaleY: Number(randomNumbers1 + "" + randomNumbers3) / 100 });
    tl.to(select(".loading__percentage"), { yPercent: 0 }, "<");
    tl.to(select(".loading__number-group.is--second .loading__number-wrap"), { yPercent: (randomNumbers1 - 1) * -10 }, "<");
    tl.to(select(".loading__number-group.is--third .loading__number-wrap"), { yPercent: (randomNumbers3 - 1) * -10 }, "<");
    tl.to(select(".loading__progress-inner"), { scaleY: Number(randomNumbers2 + "" + randomNumbers4) / 100 });
    tl.to(select(".loading__number-group.is--second .loading__number-wrap"), { yPercent: (randomNumbers2 - 1) * -10 }, "<");
    tl.to(select(".loading__number-group.is--third .loading__number-wrap"), { yPercent: (randomNumbers4 - 1) * -10 }, "<");
    tl.to(select(".loading__progress-inner"), { scaleY: 1 });
    tl.to(select(".loading__number-group.is--second .loading__number-wrap"), { yPercent: -90 }, "<");
    tl.to(select(".loading__number-group.is--third .loading__number-wrap"), { yPercent: -90 }, "<");
    tl.to(select(".loading__number-group.is--first .loading__number-wrap"), { yPercent: 0 }, "<");
  }

  document.addEventListener("astro:page-load", initLoaderThreeSteps);
  initLoaderThreeSteps();
</script>

<style>
  .loading-container { z-index: 10000; pointer-events: none; background-color: #E2E1DF; color: #111; position: fixed; inset: 0; overflow: hidden; }
  .loading-container[hidden] { display: none; }
  .loading-screen { pointer-events: auto; background-color: #E2E1DF; width: 100%; height: 100%; display: none; position: absolute; top: 0; left: 0; }
  .loading__progress { width: 1em; height: 100%; position: absolute; bottom: 0; left: 0; }
  .loading__progress-inner { transform-origin: bottom; background-color: #ff4c24; width: 100%; height: 100%; position: absolute; top: 0; left: 0; }
  .loading__numbers { flex-flow: row; align-items: flex-start; font-size: calc(10vw + 10vh); display: flex; position: absolute; bottom: .1em; left: .23em; }
  .loading__number-group { flex-flow: column; height: 1em; display: flex; position: relative; overflow: hidden; }
  .loading__number-wrap { will-change: transform; flex-flow: column; display: flex; position: relative; }
  .loading__number { text-transform: uppercase; font-family: PP Neue Corp Tight, Arial, sans-serif; font-weight: 700; line-height: 1; position: relative; opacity: 1; }
  .loading__percentage-wrap { flex-flow: column; justify-content: flex-start; margin-top: .375em; font-size: .3em; display: flex; overflow: hidden; }
  .loading__percentage { text-transform: uppercase; will-change: transform; font-family: PP Neue Corp Tight, Arial, sans-serif; font-weight: 700; line-height: 1; position: relative; opacity: 1; }
</style>
<noscript><style>.loading-container { display: none !important; }</style></noscript>
